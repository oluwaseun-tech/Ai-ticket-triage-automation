    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an AI-assisted support triage assistant for CareFlow Health, a fictional portfolio scenario.\n\nAnalyse the support ticket below. Return only valid JSON. Do not include markdown fences or explanatory text.\nNever invent refunds, account changes, or completed actions. If information is missing, use \"Unknown\".\nThe draft reply must be neutral, must not promise an outcome, and must be reviewed by a human before sending.\n\nReturn exactly this JSON structure:\n{\n  \"customer_name\": \"\",\n  \"summary\": \"\",\n  \"category\": \"\",\n  \"priority\": \"\",\n  \"sentiment\": \"\",\n  \"draft_reply\": \"\"\n}\n\nUse the current incoming support-ticket item:\nCustomer Name: {{ $json[\"Question 1 \\nFull Name\"] }}\nEmail: {{ $json[\"Question 2 \\nEmail Address\"] }}\nIssue Category: {{ $json[\"Question 3 \\nIssue Category\"] }}\nSubject: {{ $json[\"Question 4 \\nSubject\"] }}\nDescription: {{ $json[\"Question 5 \\nDescribe your issue\"] }}\nCustomer-Submitted Priority: {{ $json[\"Question 6 \\nPriority\"] }}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -32,
        -16
      ],
      "id": "37dc3f31-2d99-41f5-be23-d21b7797fe08",
      "name": " AI Ticket Analysis"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const rawOutput = item.json.output;\n\n  if (typeof rawOutput !== \"string\" || !rawOutput.trim()) {\n    throw new Error(\"AI triage returned no text output. Route this execution for manual review.\");\n  }\n\n  const cleanedOutput = rawOutput\n    .replace(/^\\s*```(?:json)?\\s*/i, \"\")\n    .replace(/\\s*```\\s*$/, \"\")\n    .trim();\n\n  let ai;\n  try {\n    ai = JSON.parse(cleanedOutput);\n  } catch (error) {\n    throw new Error(\"AI triage returned invalid JSON. Review the model output before updating the support queue.\");\n  }\n\n  const requiredFields = [\n    \"customer_name\",\n    \"summary\",\n    \"category\",\n    \"priority\",\n    \"sentiment\",\n    \"draft_reply\"\n  ];\n\n  if (!ai || typeof ai !== \"object\" || Array.isArray(ai)) {\n    throw new Error(\"AI triage output must be a JSON object.\");\n  }\n\n  for (const field of requiredFields) {\n    if (typeof ai[field] !== \"string\" || !ai[field].trim()) {\n      throw new Error(`AI triage output is missing a valid \"${field}\" field.`);\n    }\n  }\n\n  return {\n    json: {\n      ...item.json,\n      customer_name: ai.customer_name,\n      summary: ai.summary,\n      category: ai.category,\n      priority: ai.priority,\n      sentiment: ai.sentiment,\n      draft_reply: ai.draft_reply,\n      status: \"Pending\"\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        0
      ],
